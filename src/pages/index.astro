  .profile__name { font-family: var(--font-heading); font-size: var(--font-size-2xl); margin-bottom: var(--space-sm); }
  .profile__titles { color: var(--color-primary-dark); font-size: var(--font-size-sm); font-weight: 500; margin-bottom: var(--space-lg); }
  .profile__text { font-size: var(--font-size-base); line-height: 2; margin-bottom: var(--space-md); }
  .message { background: var(--color-white); border-radius: var(--border-radius-lg); padding: var(--space-2xl); border-left: 4px solid var(--color-primary-light); box-shadow: var(--shadow-sm); margin-bottom: var(--space-2xl); }
  .message p { font-size: var(--font-size-lg); line-height: 2; margin-bottom: var(--space-lg); }
  .message p:last-child { margin-bottom: 0; }
  .qualifications-wrap { margin-top: var(--space-xl); }
  .qualifications { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
  .qualifications li { display: flex; align-items: center; gap: var(--space-md); padding: var(--space-md); background: var(--color-white); border-radius: var(--border-radius); box-shadow: var(--shadow-sm); font-weight: 500; font-size: var(--font-size-sm); }
  .qual__icon { font-size: 1.25rem; flex-shrink: 0; }

  /* 料金 */
