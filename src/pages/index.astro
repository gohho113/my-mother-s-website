    .hero__subtitle br { display: none; }

    /* ニュース */
    .news-item { flex-wrap: wrap; gap: var(--space-xs) var(--space-md); }
    .news-date { min-width: auto; }

    /* はじめまして */
    .intro-text { font-size: var(--font-size-base); line-height: 1.8; }
    .intro-text br { display: none; }

    /* 特徴 */
    .features-grid { grid-template-columns: 1fr; gap: var(--space-md); }
    .feature { padding: var(--space-lg); }

    /* サービス */
    .services-grid { grid-template-columns: 1fr; gap: var(--space-md); }

    /* セッションの流れ */
    .flow__step { gap: var(--space-md); }
    .flow__number { width: 36px; height: 36px; font-size: var(--font-size-base); }

    /* プロフィール */
    .profile { grid-template-columns: 1fr; text-align: center; gap: var(--space-xl); }
    .profile__image { display: flex; justify-content: center; }
    .profile__placeholder { width: 160px; height: 160px; font-size: 3rem; margin: 0 auto; }
    .profile__text { text-align: left; }
    .profile__name { font-size: var(--font-size-xl); }
    .message { padding: var(--space-lg); }
    .message p { font-size: var(--font-size-base); line-height: 1.8; }
    .qualifications { grid-template-columns: 1fr; }

    /* 共通 */
    .section-title { font-size: var(--font-size-xl); }
    .section-subtitle { font-size: var(--font-size-base); }

    /* 料金 */
    .pricing-table { grid-template-columns: 1fr; }

    /* お問い合わせ */
    .info-grid { grid-template-columns: 1fr; }
    .form__submit .btn { width: 100%; }

    /* イベント */
    .event-card__day { font-size: var(--font-size-xl); }
    .events-loading { color: var(--color-text-light); padding: var(--space-2xl) 0; }
    .events-empty { color: var(--color-text-light); padding: var(--space-2xl) 0; text-align: center; }
  }
</style>

<script>
  // === Googleカレンダー設定 ===
  // 下の2つを設定すると、Googleカレンダーからイベントを自動取得します
  const GOOGLE_CALENDAR_ID = ''; // 例: 'xxxxxx@group.calendar.google.com'
  const GOOGLE_API_KEY = '';     // 例: 'AIzaSy...'

  const weekdays = ['日', '月', '火', '水', '木', '金', '土'];
  const grid = document.getElementById('events-grid');

  function renderEvents(events) {
    if (!events || events.length === 0) {
      grid.innerHTML = '<p class="events-empty">現在予定されているイベントはありません</p>';
      return;
    }
    grid.innerHTML = events.map(event => {
      const start = new Date(event.start.dateTime || event.start.date);
      const month = `${start.getMonth() + 1}月`;
      const day = start.getDate();
      const weekday = weekdays[start.getDay()];

      let meta = '';
      if (event.location) meta += event.location;
      if (event.start.dateTime) {
        const endTime = new Date(event.end.dateTime);
        const startStr = `${start.getHours()}:${String(start.getMinutes()).padStart(2,'0')}`;
        const endStr = `${endTime.getHours()}:${String(endTime.getMinutes()).padStart(2,'0')}`;
        meta += `${meta ? ' ／ ' : ''}${startStr}〜${endStr}`;
      }

      return `
        <div class="event-card">
          <div class="event-card__date">
            <span class="event-card__month">${month}</span>
            <span class="event-card__day">${day}</span>
            <span class="event-card__weekday">${weekday}</span>
          </div>
          <div class="event-card__info">
            <h3 class="event-card__title">${event.summary || 'イベント'}</h3>
            ${meta ? `<p class="event-card__meta">${meta}</p>` : ''}
            ${event.description ? `<p class="event-card__desc">${event.description.replace(/<[^>]*>/g, '').slice(0, 100)}</p>` : ''}
          </div>
        </div>`;
    }).join('');
  }

  function renderFallback() {
    grid.innerHTML = `
      <div class="event-card">
        <div class="event-card__date">
          <span class="event-card__month">4月</span>
          <span class="event-card__day">20</span>
          <span class="event-card__weekday">日</span>
        </div>
        <div class="event-card__info">
          <h3 class="event-card__title">春のチャレンジマルシェ</h3>
          <p class="event-card__meta">宮古市内 ／ 10:00〜15:00</p>
          <p class="event-card__desc">カラーセラピー体験ブースを出店予定。お気軽にお立ち寄りください。</p>
        </div>
      </div>
      <div class="event-card">
        <div class="event-card__date">
          <span class="event-card__month">5月</span>
          <span class="event-card__day">10</span>
          <span class="event-card__weekday">土</span>
        </div>
        <div class="event-card__info">
          <h3 class="event-card__title">ベビーマッサージ教室</h3>
          <p class="event-card__meta">宮古市内 ／ 13:00〜14:30</p>
          <p class="event-card__desc">親子で楽しめるベビーマッサージ教室です。要予約。</p>
        </div>
      </div>
      <div class="event-card">
        <div class="event-card__date">
          <span class="event-card__month">5月</span>
          <span class="event-card__day">25</span>
          <span class="event-card__weekday">日</span>
        </div>
        <div class="event-card__info">
          <h3 class="event-card__title">占い & sweets イベント</h3>
          <p class="event-card__meta">宮古市内 ／ 10:00〜16:00</p>
          <p class="event-card__desc">カラーセラピーとスイーツを楽しめるコラボイベントです。</p>
        </div>
      </div>`;
  }

  async function loadEvents() {
    if (!GOOGLE_CALENDAR_ID || !GOOGLE_API_KEY) {
      renderFallback();
      return;
    }
    try {
      const now = new Date().toISOString();
      const url = `https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(GOOGLE_CALENDAR_ID)}/events?key=${GOOGLE_API_KEY}&timeMin=${now}&maxResults=5&singleEvents=true&orderBy=startTime`;
      const res = await fetch(url);
      if (!res.ok) throw new Error('API error');
      const data = await res.json();
      renderEvents(data.items);
    } catch (e) {
      renderFallback();
    }
  }

  loadEvents();
</script>
