---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Rainbow Drops〜色のアトリエ〜" description="Rainbow Drops〜色のアトリエ〜｜カラーセラピー・心理カウンセリング・ベビーキッズマッサージ｜岩手県宮古市">

  <!-- ヒーロー -->
  <section id="home" class="hero">
    <div class="hero__bg">
      <div class="hero__circle hero__circle--1"></div>
      <div class="hero__circle hero__circle--2"></div>
      <div class="hero__circle hero__circle--3"></div>
      <div class="hero__circle hero__circle--4"></div>
    </div>
    <div class="hero__content container">
      <h1 class="hero__title">色の力で、心に寄り添う</h1>
      <p class="hero__subtitle">カラーセラピーと心理カウンセリングを通じて、<br />あなたらしい輝きを取り戻すお手伝いをします</p>
      <a href="#services" class="btn btn--primary">サービスを見る</a>
    </div>
  </section>

  <!-- ニュース & お知らせ -->
  <section id="news" class="section">
    <div class="container">
      <h2 class="section-title text-center">ニュース & お知らせ</h2>
      <hr class="rainbow-line" />
      <div class="news-list">
        <article class="news-item">
          <time class="news-date">2026.04.01</time>
          <span class="news-tag news-tag--info">お知らせ</span>
          <p class="news-title">ウェブサイトをオープンしました</p>
        </article>
        <article class="news-item">
          <time class="news-date">2026.03.15</time>
          <span class="news-tag news-tag--event">イベント</span>
          <p class="news-title">春のチャレンジマルシェに出店します</p>
        </article>
        <article class="news-item">
          <time class="news-date">2026.03.01</time>
          <span class="news-tag news-tag--info">お知らせ</span>
          <p class="news-title">4月の予約受付を開始しました</p>
        </article>
      </div>
      <p class="news-note text-center">※ 今後 microCMS を接続して更新できるようになります</p>
    </div>
  </section>

  <!-- イベントカレンダー -->
  <section id="events" class="section section--alt">
    <div class="container">
      <h2 class="section-title text-center">イベントカレンダー</h2>
      <hr class="rainbow-line" />
      <div id="events-grid" class="events-grid">
        <p class="events-loading text-center">イベント情報を読み込み中...</p>
      </div>
      <p class="news-note text-center">最新情報は <a href="https://www.instagram.com/smile7rainbow/" target="_blank" rel="noopener noreferrer">Instagram</a> もご確認ください</p>
    </div>
  </section>

  <!-- はじめまして -->
  <section class="section">
    <div class="container container--narrow text-center">
      <h2 class="section-title">はじめまして</h2>
      <hr class="rainbow-line" />
      <p class="intro-text">
        岩手県宮古市を拠点に活動している <strong>さがの みずほ</strong> です。<br />
        カラーセラピスト・心理カウンセラーとして、色彩の持つ力を通じて<br />
        心と体のバランスを整えるお手伝いをしています。
      </p>
      <p class="intro-text">
        自身も極超低体重出生児の母としての経験を持ち、<br />
        同じ悩みを抱えるお母さんたちに寄り添いたいという想いで活動しています。
      </p>
    </div>
  </section>

  <!-- サービス -->
  <section id="services" class="section section--alt">
    <div class="container">
      <h2 class="section-title text-center">サービス</h2>
      <hr class="rainbow-line" />
      <p class="section-subtitle text-center">心と体に寄り添う多彩なメニュー</p>
      <div class="services-grid">
        <div class="card" style="--card-accent: var(--color-primary-light)">
          <div class="card__accent"></div>
          <h3 class="card__title">カラーセラピー</h3>
          <p class="card__desc">直感で選んだ色から、今のあなたの心の状態やメッセージを読み解きます。自分自身を深く理解するきっかけに。</p>
          <p class="card__price">※料金はお問い合わせください</p>
        </div>
        <div class="card" style="--card-accent: var(--color-secondary-light)">
          <div class="card__accent"></div>
          <h3 class="card__title">心理カウンセリング</h3>
          <p class="card__desc">日々のストレスや子育ての悩み、人間関係など、安心できる空間でじっくりお話をお聴きします。</p>
          <p class="card__price">※料金はお問い合わせください</p>
        </div>
        <div class="card" style="--card-accent: var(--color-accent-warm)">
          <div class="card__accent"></div>
          <h3 class="card__title">ベビーキッズマッサージ</h3>
          <p class="card__desc">親子のスキンシップを通じて、赤ちゃん・お子さまとの絆を深めるマッサージをお伝えします。</p>
          <p class="card__price">※料金はお問い合わせください</p>
        </div>
        <div class="card" style="--card-accent: var(--color-accent-rose)">
          <div class="card__accent"></div>
          <h3 class="card__title">親子サポート（space♡mom）</h3>
          <p class="card__desc">同じ悩みを持つママたちが集まり、情報交換や交流ができるコミュニティです。温かい居場所を提供しています。</p>
          <p class="card__price">詳細はInstagramをご確認ください</p>
        </div>
      </div>

      <!-- セッションの流れ -->
      <div class="flow-wrap">
        <h3 class="flow-title text-center">セッションの流れ</h3>
        <div class="flow">
          <div class="flow__step">
            <div class="flow__number">1</div>
            <div class="flow__content">
              <h4>ご予約・お問い合わせ</h4>
              <p>お問い合わせフォームまたはInstagramのDMからお気軽にご連絡ください。</p>
            </div>
          </div>
          <div class="flow__step">
            <div class="flow__number">2</div>
            <div class="flow__content">
              <h4>カウンセリング</h4>
              <p>まずはゆっくりとお話をお聴きします。今のお気持ちやお悩みをお聞かせください。</p>
            </div>
          </div>
          <div class="flow__step">
            <div class="flow__number">3</div>
            <div class="flow__content">
              <h4>セッション</h4>
              <p>ご要望に合わせたセラピーを行います。カラーセラピーの場合は、直感で色をお選びいただきます。</p>
            </div>
          </div>
          <div class="flow__step">
            <div class="flow__number">4</div>
            <div class="flow__content">
              <h4>フィードバック & アフターフォロー</h4>
              <p>セッションの振り返りと日常に活かせるアドバイスをお伝えし、継続的なサポートも行います。</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 料金 -->
  <section id="pricing" class="section">
    <div class="container">
      <h2 class="section-title text-center">料金</h2>
      <hr class="rainbow-line" />
      <p class="section-subtitle text-center">各メニューの料金のご案内</p>
      <div class="pricing-table">
        <div class="pricing-card">
          <div class="pricing-card__header" style="background: var(--color-primary-light);">
            <h3 class="pricing-card__name">カラーセラピー</h3>
          </div>
          <div class="pricing-card__body">
            <div class="pricing-card__item">
              <span class="pricing-card__label">セッション（約60分）</span>
              <span class="pricing-card__price">¥3,000</span>
            </div>
            <div class="pricing-card__item">
              <span class="pricing-card__label">ペアセッション（約90分）</span>
              <span class="pricing-card__price">¥5,000</span>
            </div>
          </div>
        </div>
        <div class="pricing-card">
          <div class="pricing-card__header" style="background: var(--color-secondary-light);">
            <h3 class="pricing-card__name">心理カウンセリング</h3>
          </div>
          <div class="pricing-card__body">
            <div class="pricing-card__item">
              <span class="pricing-card__label">カウンセリング（約60分）</span>
              <span class="pricing-card__price">¥3,000</span>
            </div>
            <div class="pricing-card__item">
              <span class="pricing-card__label">オンライン（約60分）</span>
              <span class="pricing-card__price">¥3,000</span>
            </div>
          </div>
        </div>
        <div class="pricing-card">
          <div class="pricing-card__header" style="background: var(--color-accent-warm);">
            <h3 class="pricing-card__name">ベビーキッズマッサージ</h3>
          </div>
          <div class="pricing-card__body">
            <div class="pricing-card__item">
              <span class="pricing-card__label">グループレッスン（約60分）</span>
              <span class="pricing-card__price">¥2,000</span>
            </div>
            <div class="pricing-card__item">
              <span class="pricing-card__label">プライベートレッスン（約60分）</span>
              <span class="pricing-card__price">¥3,500</span>
            </div>
          </div>
        </div>
      </div>
      <p class="pricing-note text-center">※ 料金は全て税込みです。仮の金額のため、変更になる場合があります。</p>
      <p class="pricing-note text-center">※ 出張の場合は別途交通費をいただく場合があります。</p>
    </div>
  </section>

  <!-- よくある質問 -->
  <section id="faq" class="section section--alt">
    <div class="container container--narrow">
      <h2 class="section-title text-center">よくある質問</h2>
      <hr class="rainbow-line" />
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-question">カラーセラピーってどんなことをするの？</summary>
          <p class="faq-answer">色とりどりのボトルやカードの中から、直感で気になる色を選んでいただきます。選んだ色から、今のあなたの心の状態やメッセージを一緒に読み解いていきます。特別な準備は必要ありません。</p>
        </details>
        <details class="faq-item">
          <summary class="faq-question">子連れでも大丈夫ですか？</summary>
          <p class="faq-answer">はい、もちろんです！お子さま連れ大歓迎です。保育士の資格も持っていますので、安心してお越しください。</p>
        </details>
        <details class="faq-item">
          <summary class="faq-question">初めてでも受けられますか？</summary>
          <p class="faq-answer">はい、初めての方も安心してお受けいただけます。事前にカウンセリングを行い、あなたに合ったセッションをご提案します。</p>
        </details>
        <details class="faq-item">
          <summary class="faq-question">オンラインでの対応はありますか？</summary>
          <p class="faq-answer">心理カウンセリングはオンラインでも対応可能です。詳しくはお問い合わせください。</p>
        </details>
        <details class="faq-item">
          <summary class="faq-question">予約方法を教えてください</summary>
          <p class="faq-answer">ページ下部のお問い合わせフォーム、またはInstagramのDMからご連絡ください。ご希望の日時を調整いたします。</p>
        </details>
      </div>
    </div>
  </section>

  <!-- プロフィール -->
  <section id="about" class="section section--alt">
    <div class="container">
      <h2 class="section-title text-center">プロフィール</h2>
      <hr class="rainbow-line" />
      <div class="profile">
        <div class="profile__image">
          <div class="profile__placeholder"><span>🌈</span></div>
        </div>
        <div class="profile__info">
          <h3 class="profile__name">さがの みずほ</h3>
          <p class="profile__titles">カラーセラピスト ／ 心理カウンセラー ／ ベビーキッズマッサージインストラクター</p>
          <p class="profile__text">
            岩手県宮古市を拠点に、カラーセラピーと心理カウンセリングを中心とした活動をしています。
            色彩の持つ不思議な力に魅せられ、色を通じて人の心に寄り添う道を選びました。
          </p>
          <p class="profile__text">
            フリーランス保育士としての経験、子育て支援員としての活動、
            県の特別支援教育サポーターとしての知識を活かし、
            お子さまから大人の方まで、幅広くサポートしています。
          </p>
        </div>
      </div>

      <blockquote class="message">
        <p>私自身、極超低体重出生児の母です。</p>
        <p>
          子育ての中で何度も壁にぶつかり、一人で悩み、涙を流した日々がありました。
          そんな経験があるからこそ、同じように悩んでいるお母さんたちの気持ちに
          心から寄り添いたいと思っています。
        </p>
        <p>
          「一人じゃないよ」「あなたは頑張っているよ」<br />
          そんな言葉を色と一緒に届けたい。それが私の活動の原点です。
        </p>
      </blockquote>

      <div class="qualifications-wrap">
        <h3 class="flow-title text-center">資格・経歴</h3>
        <ul class="qualifications">
          <li><span>カラーセラピスト</span></li>
          <li><span>心理カウンセラー</span></li>
          <li><span>ベビーキッズマッサージインストラクター</span></li>
          <li><span>フリーランス保育士</span></li>
          <li><span>子育て支援員</span></li>
          <li><span>県特別支援教育サポーター</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- フォトギャラリー -->
  <section id="gallery" class="section">
    <div class="container">
      <h2 class="section-title text-center">ギャラリー</h2>
      <hr class="rainbow-line" />
      <p class="section-subtitle text-center">活動の様子をお届けします</p>
      <div class="gallery-grid">
        <div class="gallery-item">
          <img src="https://images.unsplash.com/photo-1557672172-298e090bd0f1?w=600&h=600&fit=crop" alt="カラーセラピー" loading="lazy" />
        </div>
        <div class="gallery-item">
          <img src="https://images.unsplash.com/photo-1488459716781-31db52582fe9?w=600&h=600&fit=crop" alt="マルシェ出店" loading="lazy" />
        </div>
        <div class="gallery-item">
          <img src="https://images.unsplash.com/photo-1492725764893-90b379c2b6e7?w=600&h=600&fit=crop" alt="ベビーマッサージ" loading="lazy" />
        </div>
        <div class="gallery-item">
          <img src="https://images.unsplash.com/photo-1573497620053-ea5300f94f21?w=600&h=600&fit=crop" alt="カウンセリング" loading="lazy" />
        </div>
        <div class="gallery-item">
          <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=600&h=600&fit=crop" alt="コミュニティ" loading="lazy" />
        </div>
        <div class="gallery-item">
          <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&h=600&fit=crop" alt="イベント" loading="lazy" />
        </div>
      </div>
      <p class="news-note text-center">※ イメージ写真です。実際の活動写真に差し替え予定</p>
    </div>
  </section>

  <!-- Instagram -->
  <section class="section section--alt">
    <div class="container text-center">
      <h2 class="section-title">Instagram</h2>
      <hr class="rainbow-line" />
      <p class="section-subtitle">最新の活動はInstagramでも発信しています</p>
      <div class="instagram-embed">
        <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/smile7rainbow/" data-instgrm-version="14">
          <a href="https://www.instagram.com/smile7rainbow/" target="_blank" rel="noopener noreferrer">@smile7rainbow の投稿を見る</a>
        </blockquote>
      </div>
      <div style="margin-top: var(--space-xl); text-align: center;">
        <a href="https://www.instagram.com/smile7rainbow/" target="_blank" rel="noopener noreferrer" class="btn btn--outline">
          Instagramをフォローする
        </a>
      </div>
    </div>
  </section>
  <script async src="//www.instagram.com/embed.js"></script>

  <!-- お問い合わせ -->
  <section id="contact" class="section">
    <div class="container">
      <h2 class="section-title text-center">お問い合わせ</h2>
      <hr class="rainbow-line" />
      <p class="section-subtitle text-center">ご予約・ご質問などお気軽にどうぞ</p>

      <form class="form" action="#" method="POST">
        <div class="form__group">
          <label class="form__label" for="name">お名前 <span class="form__required">必須</span></label>
          <input class="form__input" type="text" id="name" name="name" required placeholder="例：山田 花子" />
        </div>
        <div class="form__group">
          <label class="form__label" for="email">メールアドレス <span class="form__required">必須</span></label>
          <input class="form__input" type="email" id="email" name="email" required placeholder="例：example@email.com" />
        </div>
        <div class="form__group">
          <label class="form__label" for="phone">電話番号 <span class="form__optional">任意</span></label>
          <input class="form__input" type="tel" id="phone" name="phone" placeholder="例：090-1234-5678" />
        </div>
        <div class="form__group">
          <label class="form__label" for="subject">ご相談内容</label>
          <select class="form__input" id="subject" name="subject">
            <option value="">お選びください</option>
            <option value="color-therapy">カラーセラピーについて</option>
            <option value="counseling">心理カウンセリングについて</option>
            <option value="baby-massage">ベビーキッズマッサージについて</option>
            <option value="space-mom">space♡mom について</option>
            <option value="other">その他</option>
          </select>
        </div>
        <div class="form__group">
          <label class="form__label" for="message">メッセージ <span class="form__required">必須</span></label>
          <textarea class="form__input form__textarea" id="message" name="message" required rows="6" placeholder="お気軽にご相談内容をご記入ください"></textarea>
        </div>
        <div class="form__submit">
          <button type="submit" class="btn btn--primary">送信する</button>
        </div>
      </form>

      <div class="info-grid">
        <div class="info-card">
          <h4 class="info-card__title">所在地</h4>
          <p>岩手県宮古市</p>
          <p class="info-note">※詳しい住所はご予約時にお伝えします</p>
        </div>
        <div class="info-card">
          <h4 class="info-card__title">営業時間</h4>
          <p>10:00 〜 17:00</p>
          <p class="info-note">※完全予約制</p>
        </div>
        <div class="info-card">
          <h4 class="info-card__title">Instagram</h4>
          <p><a href="https://www.instagram.com/smile7rainbow/" target="_blank" rel="noopener noreferrer">@smile7rainbow</a></p>
          <p class="info-note">DMでもお気軽にどうぞ</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LINE固定ボタン -->
  <div class="line-float">
    <a href="https://line.me/R/ti/p/@657fiibx" target="_blank" rel="noopener noreferrer" class="line-float__btn" aria-label="LINEで相談する">
      <svg class="line-float__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
      <span class="line-float__text">LINEで相談</span>
    </a>
  </div>

</BaseLayout>

<style>
  /* ニュース */
  .news-list { max-width: 700px; margin: 0 auto; }
  .news-item { display: flex; align-items: center; gap: var(--space-md); padding: var(--space-md) 0; border-bottom: 1px solid var(--color-border); }
  .news-date { font-size: var(--font-size-sm); color: var(--color-text-light); white-space: nowrap; min-width: 90px; }
  .news-tag { font-size: 0.7rem; padding: 2px 10px; border-radius: 50px; white-space: nowrap; font-weight: 500; }
  .news-tag--info { background: var(--color-primary-light); color: var(--color-white); }
